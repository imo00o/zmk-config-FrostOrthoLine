// FrostOrthoLine 共通定義（キーマトリクス・PAW3222・FPC2 の I2C バス）
// FPC2 に何をつなぐかは各シールドの overlay で決める
//   FrostOrthoLine.overlay         : hires-dial（ダイヤル）
//   FrostOrthoLine_pat9125.overlay : PAT9125 をトラックボールとして使う（試験用）

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
// 注意: ポインティング系のヘッダ（keys.h を含む）はマトリクス定義より後で include すること。
// keys.h が修飾キー用の RC(keycode) を定義するため、先に読むと RC(行,列) がエラーになる。

// ========================================
// ピン割り当て（XIAO nRF52840 Plus）
// ========================================
//  ROW0 = D5  (P0.05)    COL0 = D4  (P0.04)
//  ROW1 = D16 (P0.31)    COL1 = D14 (P0.09 / NFC1)
//  ROW2 = D6  (P1.11)    COL2 = D3  (P0.29)
//  ROW3 = D8  (P1.13)    COL3 = D13 (P1.01)
//  ROW4 = D17 (P1.03)    COL4 = D2  (P0.28)
//  ROW5 = D7  (P1.12)    COL5 = D15 (P0.10 / NFC2)
//
//  PAW3222 (FPC1, SPI)        ダイヤルモジュール PAT9125 + プッシュスイッチ (FPC2)
//   SCLK   = D18 (P1.05)       基板ピン名       接続先       モジュール側
//   SDIO   = D9  (P1.14)       SDA/SCLK     = D0  (P0.02) = SDA
//   MOTION = D19 (P1.07)       SCL/SDIO     = D11 (P0.15) = SCL
//   CS     = D10 (P1.15)       GND/MOTION   = D1  (P0.03) = PUSH（押し込みで L）
//                              RDY/CS       = D12 (P0.19) = MOTION
//  ※ FPC2 の基板ピン名とダイヤルモジュールのピンは役割が一致しないので注意

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "default_layout";

        kscan = <&kscan_composite>;
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500    0       0     0     0>
            , <&key_physical_attrs 100 100  600    0       0     0     0>
            , <&key_physical_attrs 100 100  700    0       0     0     0>
            , <&key_physical_attrs 100 100  800    0       0     0     0>
            , <&key_physical_attrs 100 100  900    0       0     0     0>
            , <&key_physical_attrs 100 100 1000    0       0     0     0>
            , <&key_physical_attrs 100 100 1100    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  500  100       0     0     0>
            , <&key_physical_attrs 100 100  600  100       0     0     0>
            , <&key_physical_attrs 100 100  700  100       0     0     0>
            , <&key_physical_attrs 100 100  800  100       0     0     0>
            , <&key_physical_attrs 100 100  900  100       0     0     0>
            , <&key_physical_attrs 100 100 1000  100       0     0     0>
            , <&key_physical_attrs 100 100 1100  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  200       0     0     0>
            , <&key_physical_attrs 100 100  600  200       0     0     0>
            , <&key_physical_attrs 100 100  700  200       0     0     0>
            , <&key_physical_attrs 100 100  800  200       0     0     0>
            , <&key_physical_attrs 100 100  900  200       0     0     0>
            , <&key_physical_attrs 100 100 1000  200       0     0     0>
            , <&key_physical_attrs 100 100 1100  200       0     0     0>
            , <&key_physical_attrs 100 100 1250  100       0     0     0>  // ダイヤルのプッシュスイッチ
            ;
    };

    // 電気的マトリクス 6行 x 6列 = 36キー → 物理配置 12列 x 3行
    // 1本の COL が物理2列分を担当する（RC(行,列) = RC(ROW,COL)）
    // キーボードを上から見て左から（COL5 が左端、COL0 が右端）:
    //   上段: COL5/ROW3, COL5/ROW0, COL4/ROW3, COL4/ROW0, ... COL0/ROW3, COL0/ROW0
    //   中段: COL5/ROW4, COL5/ROW1, COL4/ROW4, COL4/ROW1, ... COL0/ROW4, COL0/ROW1
    //   下段: COL5/ROW5, COL5/ROW2, COL4/ROW5, COL4/ROW2, ... COL0/ROW5, COL0/ROW2
    // 最後の RC(6,0) はダイヤルのプッシュスイッチ（kscan_push）
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <7>;
        map = <
            RC(3,5) RC(0,5) RC(3,4) RC(0,4) RC(3,3) RC(0,3)   RC(3,2) RC(0,2) RC(3,1) RC(0,1) RC(3,0) RC(0,0)
            RC(4,5) RC(1,5) RC(4,4) RC(1,4) RC(4,3) RC(1,3)   RC(4,2) RC(1,2) RC(4,1) RC(1,1) RC(4,0) RC(1,0)
            RC(5,5) RC(2,5) RC(5,4) RC(2,4) RC(5,3) RC(2,3)   RC(5,2) RC(2,2) RC(5,1) RC(2,1) RC(5,0) RC(2,0)
            RC(6,0)
        >;
    };

    // キーマトリクスとプッシュスイッチをまとめて1つの kscan として扱う
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        wakeup-source;
        rows = <7>;
        columns = <6>;

        matrix {
            kscan = <&kscan0>;
        };

        push {
            kscan = <&kscan_push>;
            row-offset = <6>;
        };
    };

    // ダイヤルのプッシュスイッチ（押し込むと L になるのでプルアップして Active Low で読む）
    kscan_push: kscan_push {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  /* D1 */
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0  5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW0 D5  */
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW1 D16 */
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW2 D6  */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW3 D8  */
            , <&gpio1  3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW4 D17 */
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* ROW5 D7  */
            ;

        col-gpios
            = <&gpio0  4 GPIO_ACTIVE_HIGH>  /* COL0 D4  */
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  /* COL1 D14 */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  /* COL2 D3  */
            , <&gpio1  1 GPIO_ACTIVE_HIGH>  /* COL3 D13 */
            , <&gpio0 28 GPIO_ACTIVE_HIGH>  /* COL4 D2  */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>  /* COL5 D15 */
            ;
    };
};

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <zephyr/dt-bindings/dt-util.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <mouse-gesture.dtsi>

// COL1(P0.09) / COL5(P0.10) は NFC ピンなので GPIO として使う設定
// （Zephyr 4.x では Kconfig の CONFIG_NFCT_PINS_AS_GPIOS ではなくこちら）
&uicr {
    nfct-pins-as-gpios;
};

// ========================================
// ポインティング設定（DYA Studio から変更可能）
// ここの値は初期値。DYA Studio で保存した設定があればそちらが優先される
// ========================================

// PAW3222: カーソル移動 + AML
&mouse_runtime_input_processor {
    scale-multiplier = <2>; // カーソル移動量2/3倍
    scale-divisor = <3>;
    x-invert; // カーソルの移動方向調整（センサーの向きに合わせて変更）
    y-invert;

    // AML（自動マウスレイヤー）
    temp-layer-enabled;
    temp-layer = <6>;
    temp-layer-activation-delay-ms = <400>; // キー入力後400ms以内はAMLに切り替わらない
    temp-layer-deactivation-delay-ms = <65535>; // タイムアウト時間（最大65535ms）
};

// PAW3222: 縦スクロール（レイヤー5押下中）
&scroll_runtime_input_processor {
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    active-layers = <BIT(5)>;
    scale-multiplier = <2>;
    scale-divisor = <3>;
    x-invert;
    y-invert;
    axis-snap-mode = <AXIS_SNAP_MODE_Y>;
    axis-snap-threshold = <65535>;
};

/ {
    // PAW3222: 横スクロール（レイヤー7押下中）
    hscroll_runtime_input_processor: hscroll_runtime_input_processor {
        compatible = "zmk,input-processor-runtime";
        processor-label = "hscroll";
        type = <INPUT_EV_REL>;
        x-codes = <INPUT_REL_X>;
        y-codes = <INPUT_REL_Y>;
        xy-to-scroll-enabled;
        active-layers = <BIT(7)>;
        scale-multiplier = <2>;
        scale-divisor = <3>;
        rotation-degrees = <0>;
        track-remainders;
        axis-snap-mode = <AXIS_SNAP_MODE_X>;
        axis-snap-threshold = <65535>;

        temp-layer-transparent-behavior = <&trans>;
        temp-layer-kp-behavior = <&kp>;
        temp-layer-keep-keycodes = <LEFT_CONTROL LEFT_SHIFT LEFT_ALT LEFT_GUI RIGHT_CONTROL RIGHT_SHIFT RIGHT_ALT RIGHT_GUI>;

        #input-processor-cells = <0>;
    };

    trackball1_listener: trackball1_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball1>;

        input-processors = <
            &mouse_runtime_input_processor
            &zip_mouse_gesture // マウスジェスチャー（方向調整後に置くこと）
            &scroll_runtime_input_processor
            &hscroll_runtime_input_processor
        >;
    };
};

// ========================================
// SPI（PAW3222, FPC1）
// PAW3222 は 3線式 SPI（SDIO 1本で送受信）なので MOSI と MISO を同じピンにする
// ========================================

// 基板標準の spi2 (xiao_spi) は D8〜D10 (P1.13〜P1.15) を使うため、
// ROW3 / SDIO / CS と衝突しないよう無効化する
&spi2 {
    status = "disabled";
};

// spi0 と i2c0、spi1 と i2c1 はそれぞれ同じペリフェラルを共有する
&i2c0 {
    status = "disabled";
};

&spi1 {
    status = "disabled";
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                <NRF_PSEL(SPIM_MISO, 1, 14)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };

    // 基板標準の i2c1 は D4/D5 (P0.04/P0.05) を使うので FPC2 のピンに付け替える
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 15)>;
            bias-pull-up;
        };
    };

    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 2)>,
                <NRF_PSEL(TWIM_SCL, 0, 15)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;

    trackball1: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <1500>;
    };
};

// FPC2 の I2C バス（センサーノードは各シールドの overlay で追加）
&i2c1 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;
};
